# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example file is committed and must never contain real secrets.

# Name shown to clients in GET /api/v1/info
VIANDEN_SERVER_NAME=My Vianden Server

# Address the HTTP server listens on (plain HTTP for local development)
VIANDEN_LISTEN_ADDR=:8080

# PostgreSQL connection string (matches the local docker-compose.yml)
VIANDEN_DATABASE_URL=postgres://vianden:change-me@localhost:5432/vianden?sslmode=disable
