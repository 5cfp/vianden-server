# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example file is committed and must never contain real secrets.

# ---- Server ----

# Name shown to clients in GET /api/v1/info
VIANDEN_SERVER_NAME=My Vianden Server

# ---- HTTPS ----
# How the server provides HTTPS:
#   plain        no HTTPS: local development, or behind a reverse proxy that does HTTPS
#   autocert     free Let's Encrypt certificate, renewed automatically (needs VIANDEN_DOMAIN,
#                and ports 80 + 443 reachable from the internet)
#   self-signed  the server makes its own certificate (IP-only servers; the app asks users
#                to confirm its fingerprint the first time = "trust on first use")
VIANDEN_TLS_MODE=plain

# plain mode: address the HTTP server listens on.
# 127.0.0.1 = only this PC can connect. Use :8080 to allow other devices.
# Address the HTTP server listens on (plain HTTP for local development).
# 127.0.0.1 = only this PC can connect. Use :8080 to allow other devices.
VIANDEN_LISTEN_ADDR=127.0.0.1:8080

# autocert / self-signed: HTTPS address, and (autocert only) the plain-HTTP address used for
# Let's Encrypt's domain check and for redirecting to HTTPS.
VIANDEN_HTTPS_ADDR=:443
VIANDEN_HTTP_ADDR=:80

# Public name of the server (required for autocert), e.g. chat.example.com
VIANDEN_DOMAIN=

# Optional: Let's Encrypt emails this address about certificate problems.
VIANDEN_ACME_EMAIL=

# Where the server keeps files it creates (certificates). Keep it private and backed up.
VIANDEN_DATA_DIR=./data

# PostgreSQL connection string used by the server.
# User, password, and database name must match the VIANDEN_DB_* values below.
VIANDEN_DATABASE_URL=postgres://vianden:change-me@localhost:5432/vianden?sslmode=disable

# ---- Local PostgreSQL (used by docker-compose.yml) ----
VIANDEN_DB_USER=vianden
VIANDEN_DB_NAME=vianden
VIANDEN_DB_PASSWORD=change-me

# ---- Tests ----
# Separate database for automated tests (go test). Tests DELETE all data in it.
# Create it once: docker compose exec postgres createdb -U vianden vianden_test
VIANDEN_TEST_DATABASE_URL=postgres://vianden:change-me@localhost:5432/vianden_test?sslmode=disable
