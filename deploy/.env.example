# Settings for deploy/docker-compose.yml. Copy to deploy/.env and edit.
# deploy/.env holds the database password: never commit it, never share it.

# Name shown in the app.
VIANDEN_SERVER_NAME=My Vianden Server

# Your server's public name. Its DNS "A" record must point to your public IP.
VIANDEN_DOMAIN=chat.example.com

# Optional: Let's Encrypt emails this address about certificate problems.
VIANDEN_ACME_EMAIL=

# autocert (Let's Encrypt, needs VIANDEN_DOMAIN) or self-signed (IP-only servers).
VIANDEN_TLS_MODE=autocert

# Database password. Generate a long random one, for example:  openssl rand -hex 32
# (letters and digits only, so it is safe inside the database URL)
DB_PASSWORD=change-me

# Backups: how often, and how long to keep them.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
